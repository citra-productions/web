{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citra-production-web",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "cp.atalariq.dev",
      "custom_domain": true
    }
  ]
}
